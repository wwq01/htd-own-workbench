{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口能力：拉起 htd-backend sidecar、用系统默认程序打开数据目录、发送系统通知",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/htd-backend",
          "sidecar": true
        }
      ]
    }
  ]
}
