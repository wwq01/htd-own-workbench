{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口能力：允许以 spawn 方式拉起 htd-backend sidecar",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/htd-backend",
          "sidecar": true
        }
      ]
    }
  ]
}
