# 荒天帝工作台 · 服务端部署配置模板
# 用法：复制为同目录 server.env（该文件已在 .gitignore 中，不会误传令牌），按需修改后运行 start 脚本。
#
# 全部变量均可选；不设置即为「仅本机」模式（与改造前行为完全一致）。

# 监听地址：127.0.0.1 = 仅本机（默认，最安全）；0.0.0.0 = 允许局域网/其他设备访问
HTD_HOST=0.0.0.0

# 服务端口（可用端口固定为 17388 / 17389 / 17390，被占用会自动顺延）
HTD_PORT=17388

# 服务端常驻模式：1 = 不开浏览器、不做「端口占用则复用退出」
# 由 start 脚本强制置 1，此处保留仅为说明
HTD_SERVER=1

# 局域网模式：1 = 自动把本机所有内网 IP 加入来源白名单（换 IP 不失效，免去手工列举）
# 仅当 HTD_HOST=0.0.0.0 或绑定内网网卡时才有意义
HTD_LAN=1

# 访问令牌：留空 = 不鉴权（仅本机时安全）
# 一旦 HTD_HOST 非 127.0.0.1，强烈建议设置——否则任何能访问该端口的人都可读写全部数据。
# 例：HTD_ACCESS_TOKEN=My$tr0ng-Token
HTD_ACCESS_TOKEN=

# 数据库主密码（V2-3 静态加密）：启用加密后必填，否则常驻模式无法解锁（会直接退出）
# 未启用加密时留空即可，完全无影响。
# 启用方式：node backend/scripts/enable-encryption.mjs（会先备份明文库）
# ⚠️ 遗忘主密码 = 数据不可恢复，务必先备份；口令写在本文件时请确认文件权限安全。
HTD_DB_PASSPHRASE=

# 数据目录：留空则读取 D:\荒天帝工作台\settings.json 中的 dataRoot
# HTD_DATA_ROOT=D:\荒天帝工作台

# 反向代理信任：1 = 启用 express trust proxy，使日志/限流取到 X-Forwarded-For 真实 IP
# 仅在前面挂了 nginx / Caddy 等反向代理时开启
HTD_TRUST_PROXY=

# 额外允许来源（逗号分隔）：反向代理到域名时填写页面实际访问地址
# 例：HTD_ALLOWED_ORIGINS=https://htd.example.com,http://192.168.1.10:17388
HTD_ALLOWED_ORIGINS=

# ── 异地备份（V2-2，默认关闭）────────────────────────────────────────────
# 解决的问题：本地备份与数据库在同一块磁盘上，磁盘故障/机器丢失时两者同时消失。
# 加密（V2-3）保护机密性，异地备份保护可用性，二者互补不可互相替代。
#
# 不配置 HTD_REMOTE_BACKUP_TARGET 即完全关闭：零网络请求、零行为变化。
# ⚠️ target 一旦填写了不受支持的值（如 s3）会直接报错暴露，不会静默跳过——
#    静默跳过会让用户误以为备份在跑实则没有，这比报错危险得多。
# HTD_REMOTE_BACKUP_TARGET=local|webdav

# ── 目标一：本机另一块盘 / 已挂载的网络共享（最易验证，推荐先用它跑通）────
# HTD_REMOTE_BACKUP_TARGET=local
# HTD_REMOTE_BACKUP_PATH=E:\htd-offsite        # 另一块物理盘，或 \\NAS\backup

# ── 目标二：WebDAV（坚果云 / 群晖 / Nextcloud / ownCloud 等）──────────────
# HTD_REMOTE_BACKUP_TARGET=webdav
# HTD_REMOTE_BACKUP_URL=https://dav.jianguoyun.com/dav/
# HTD_REMOTE_BACKUP_USER=your-account
# HTD_REMOTE_BACKUP_PASS=your-app-password     # 建议用应用专用密码而非账号密码

# 远端子目录（两种目标通用）：本应用只在该目录内活动，清理时也只删自己的 daily 备份
# HTD_REMOTE_BACKUP_DIR=htd-backups
# 远端保留份数（仅清理每日备份；手动备份永久保留，与本地策略一致）
# HTD_REMOTE_BACKUP_KEEP=30
