{
  "id": "liquid-glass",
  "name": "Liquid Glass",
  "version": "1.4.0",
  "appearance": "liquid-glass",
  "supportsDarkLight": true,
  "dark": {
    "colorPalette": {
      "bgBase": "#0B1220",
      "bgPage": "#0F172A",
      "panel": "#1E293B",
      "fgPrimary": "#F1F5F9",
      "fgSecondary": "#CBD5E1",
      "fgTertiary": "#94A3B8",
      "accent": "#5B8DEF",
      "accentDanger": "#EF4444",
      "success": "#10B981",
      "warning": "#F59E0B",
      "info": "#6366F1"
    },
    "borderRadius": { "sm": 6, "md": 12, "lg": 16, "xl": 22 },
    "shadows": {
      "card": "inset 0 1px 0 rgba(255,255,255,0.18), 0 4px 18px rgba(0,0,0,0.18)",
      "modal": "inset 0 1px 0 rgba(255,255,255,0.20), 0 8px 30px rgba(0,0,0,0.28)"
    },
    "typography": {
      "fontFamily": "Sarasa Gothic SC, Inter, -apple-system, BlinkMacSystemFont, Microsoft YaHei, PingFang SC, sans-serif",
      "fontSizeBase": 14,
      "lineHeightBase": 1.5
    },
    "motion": {
      "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "durations": { "in_fast": 80, "in": 150, "in_slow": 200, "out_fast": 60, "out": 120, "out_slow": 180 }
    },
    "spacing": { "xs": 4, "sm": 8, "md": 12, "base": 16, "lg": 20, "xl": 24, "2xl": 32 },
    "decorations": { "decryptedText": true, "lightSpots": true, "noiseTexture": false, "glassStyle": "glass" }
  },
  "light": {
    "colorPalette": {
      "bgBase": "#E2E8F0",
      "bgPage": "#F8FAFC",
      "panel": "#FFFFFF",
      "fgPrimary": "#0F172A",
      "fgSecondary": "#334155",
      "fgTertiary": "#475569",
      "accent": "#2F6BEE",
      "accentDanger": "#DC2626",
      "success": "#059669",
      "warning": "#D97706",
      "info": "#4F46E5"
    },
    "borderRadius": { "sm": 6, "md": 12, "lg": 16, "xl": 22 },
    "shadows": {
      "card": "inset 0 1px 0 rgba(255,255,255,0.85), 0 4px 18px rgba(15,23,42,0.14)",
      "modal": "inset 0 1px 0 rgba(255,255,255,0.85), 0 8px 30px rgba(15,23,42,0.16)"
    },
    "typography": {
      "fontFamily": "Sarasa Gothic SC, Inter, -apple-system, BlinkMacSystemFont, Microsoft YaHei, PingFang SC, sans-serif",
      "fontSizeBase": 14,
      "lineHeightBase": 1.5
    },
    "motion": {
      "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "durations": { "in_fast": 80, "in": 150, "in_slow": 200, "out_fast": 60, "out": 120, "out_slow": 180 }
    },
    "spacing": { "xs": 4, "sm": 8, "md": 12, "base": 16, "lg": 20, "xl": 24, "2xl": 32 },
    "decorations": { "decryptedText": true, "lightSpots": true, "noiseTexture": false, "glassStyle": "glass" }
  }
}
