{
  "id": "notion-flat",
  "name": "Notion 极简平铺",
  "version": "1.4.0",
  "appearance": "notion-flat",
  "supportsDarkLight": true,
  "dark": {
    "colorPalette": {
      "bgBase": "#0F172A",
      "bgPage": "#0F172A",
      "panel": "#1E293B",
      "fgPrimary": "#F1F5F9",
      "fgSecondary": "#CBD5E1",
      "fgTertiary": "#94A3B8",
      "accent": "#5B8DEF",
      "accentDanger": "#EF4444",
      "success": "#10B981",
      "warning": "#F59E0B",
      "info": "#6366F1"
    },
    "borderRadius": { "sm": 4, "md": 6, "lg": 8, "xl": 12 },
    "shadows": {
      "card": "none",
      "modal": "0 1px 2px rgba(0,0,0,0.30)"
    },
    "typography": {
      "fontFamily": "Sarasa Gothic SC, Inter, -apple-system, BlinkMacSystemFont, Microsoft YaHei, PingFang SC, sans-serif",
      "fontSizeBase": 14,
      "lineHeightBase": 1.5
    },
    "motion": {
      "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "durations": { "in_fast": 80, "in": 150, "in_slow": 200, "out_fast": 60, "out": 120, "out_slow": 180 }
    },
    "spacing": { "xs": 4, "sm": 8, "md": 12, "base": 12, "lg": 20, "xl": 24, "2xl": 32 },
    "decorations": { "decryptedText": false, "lightSpots": false, "noiseTexture": false, "glassStyle": "flat" }
  },
  "light": {
    "colorPalette": {
      "bgBase": "#F1F5F9",
      "bgPage": "#F1F5F9",
      "panel": "#FFFFFF",
      "fgPrimary": "#0F172A",
      "fgSecondary": "#334155",
      "fgTertiary": "#475569",
      "accent": "#2F6BEE",
      "accentDanger": "#DC2626",
      "success": "#059669",
      "warning": "#D97706",
      "info": "#4F46E5"
    },
    "borderRadius": { "sm": 4, "md": 6, "lg": 8, "xl": 12 },
    "shadows": {
      "card": "none",
      "modal": "0 1px 2px rgba(15,23,42,0.12)"
    },
    "typography": {
      "fontFamily": "Sarasa Gothic SC, Inter, -apple-system, BlinkMacSystemFont, Microsoft YaHei, PingFang SC, sans-serif",
      "fontSizeBase": 14,
      "lineHeightBase": 1.5
    },
    "motion": {
      "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "durations": { "in_fast": 80, "in": 150, "in_slow": 200, "out_fast": 60, "out": 120, "out_slow": 180 }
    },
    "spacing": { "xs": 4, "sm": 8, "md": 12, "base": 12, "lg": 20, "xl": 24, "2xl": 32 },
    "decorations": { "decryptedText": false, "lightSpots": false, "noiseTexture": false, "glassStyle": "flat" }
  }
}
