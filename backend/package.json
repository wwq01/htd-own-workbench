{
  "name": "huangtiandi-workbench-backend",
  "version": "1.0.0",
  "description": "荒天帝工作台 - 后端服务",
  "type": "module",
  "main": "build/server.cjs",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "build:prepare": "node scripts/prepare-build.mjs",
    "build:entry": "node scripts/build-entry.mjs",
    "build:template": "node scripts/build-template-db.mjs",
    "build:win": "npm run build:prepare && npm run build:template && npm run build:entry && pkg --targets node24-win-x64 --fallback-to-source --public --output ../build/荒天帝工作台.exe .",
    "build:mac": "npm run build:prepare && pkg --targets node22-macos-x64 --output ../build/荒天帝工作台-macos ."
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "winston": "^3.14.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "6.22.0",
    "prisma": "^5.22.0",
    "sql.js": "^1.14.1",
    "vitest": "^4.1.10"
  },
  "bin": "build/server.cjs",
  "pkg": {
    "scripts": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "assets": [
      "../frontend/**/*",
      "prisma/schema.prisma",
      "prisma/template.db",
      "node_modules/.prisma/client/**/*",
      "node_modules/@prisma/client/**/*",
      "node_modules/@prisma/engines/**/*"
    ]
  }
}
